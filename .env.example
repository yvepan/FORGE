# Copy to .env and fill in your authorized model-service origin and credential.
FORGE_API_ORIGIN=https://YOUR_AUTHORIZED_MODEL_HOST
FORGE_API_KEY=YOUR_OWN_API_KEY

# Victim family/API model and defense are explicit init arguments, then frozen.
# Primary and auxiliary roles use the same backbone. QP/KE/RQA use Gemini.
# PPL filtering uses a separately filtered full-corpus manifest (GPT-2, 111.71).

# Optional transient gateway retries; never replays a stream after output starts.
FORGE_GATEWAY_RETRIES=1

# Optional proxy settings, only if required by your network.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost
